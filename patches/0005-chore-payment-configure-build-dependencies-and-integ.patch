 create mode 100644 core/payment/src/main/AndroidManifest.xml

diff --git a/build-logic/convention/src/main/kotlin/FeatureConventionPlugin.kt b/build-logic/convention/src/main/kotlin/FeatureConventionPlugin.kt
index aa76abe..84fb949 100644
