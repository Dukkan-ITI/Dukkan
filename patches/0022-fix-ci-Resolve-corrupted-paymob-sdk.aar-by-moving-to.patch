From daaf90fd96d28545418eeb0be21e0631503ee1fb Mon Sep 17 00:00:00 2001
From: "hazemkora660@gmail.com" <hazemkora660@gmail.com>
Date: Sat, 4 Jul 2026 20:28:06 +0300
Subject: [PATCH 22/24] fix(ci): Resolve corrupted paymob-sdk.aar by moving to
 CI-download approach

---
 .github/workflows/android-pr-check.yml |   9 ++++++++-
 .gitignore                             | Bin 1033 -> 1153 bytes
 app/libs/paymob-sdk.aar                |   3 ---
 core/payment/README.md                 |   8 ++++++++
 domain-compile.log                     | Bin 0 -> 16598 bytes
 5 files changed, 16 insertions(+), 4 deletions(-)
 delete mode 100644 app/libs/paymob-sdk.aar
 create mode 100644 domain-compile.log

diff --git a/.github/workflows/android-pr-check.yml b/.github/workflows/android-pr-check.yml
index 4299dcf..34c0f86 100644
--- a/.github/workflows/android-pr-check.yml
+++ b/.github/workflows/android-pr-check.yml
@@ -58,8 +58,15 @@ jobs:
       - name: Validate google-services.json
         run: jq empty app/google-services.json
 
+      - name: Download Paymob SDK
+        env:
+          PAYMOB_SDK_URL: ${{ secrets.PAYMOB_SDK_DOWNLOAD_URL }}
+        run: |
+          curl -L "$PAYMOB_SDK_URL" -o app/libs/paymob-sdk.aar
+          unzip -t app/libs/paymob-sdk.aar
+
       - name: Build Android App
-        run: ./gradlew :app:assembleDebug --stacktrace --no-daemon
+        run: ./gradlew :app:assembleDebug --stacktrace --no-daemon --no-build-cache
 
       - name: Run Android Lint
         run: ./gradlew :app:lintDebug --stacktrace --no-daemon
