From effa3b149f0e14913f5f5968299d61c49998ad92 Mon Sep 17 00:00:00 2001
From: "hazemkora660@gmail.com" <hazemkora660@gmail.com>
Date: Sat, 4 Jul 2026 15:13:39 +0300
Subject: [PATCH 11/24] feat(payment): add cash integration ID to Paymob
 request

- Include Paymob integration ID 5766720 for Cash payments
---
 .../dukkan/payment/data/repository/PaymentRepositoryImpl.kt  | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/core/payment/src/main/java/com/dukkan/payment/data/repository/PaymentRepositoryImpl.kt b/core/payment/src/main/java/com/dukkan/payment/data/repository/PaymentRepositoryImpl.kt
index bacdcfd..e3f5776 100644
--- a/core/payment/src/main/java/com/dukkan/payment/data/repository/PaymentRepositoryImpl.kt
+++ b/core/payment/src/main/java/com/dukkan/payment/data/repository/PaymentRepositoryImpl.kt
@@ -49,9 +49,10 @@ internal class PaymentRepositoryImpl @Inject constructor(
             put("amount", amountInCents) 
             put("currency", cartTotal.currencyCode)
             
-            // Add the integration ID here!
+            // Add the integration IDs here!
             val paymentMethods = org.json.JSONArray().apply {
-                put(5766356) // Integration ID from the user's dashboard
+                put(5766356) // VPC (Card) Integration ID
+                put(5766720) // Cash Integration ID
             }
             put("payment_methods", paymentMethods)
             
-- 
