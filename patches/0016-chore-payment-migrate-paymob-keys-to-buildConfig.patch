Subject: [PATCH 16/24] chore(payment): migrate paymob keys to buildConfig

- Remove hardcoded Paymob secrets from PaymentRepositoryImpl

- Map BuildConfig properties generated via gradle.properties
---
 .../dukkan/payment/data/repository/PaymentRepositoryImpl.kt   | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/payment/src/main/java/com/dukkan/payment/data/repository/PaymentRepositoryImpl.kt b/core/payment/src/main/java/com/dukkan/payment/data/repository/PaymentRepositoryImpl.kt
index 9ad88cc..e658af7 100644
--- a/core/payment/src/main/java/com/dukkan/payment/data/repository/PaymentRepositoryImpl.kt
+++ b/core/payment/src/main/java/com/dukkan/payment/data/repository/PaymentRepositoryImpl.kt
@@ -41,8 +41,8 @@ internal class PaymentRepositoryImpl @Inject constructor(
         cartTotal: com.msayeh.domain.model.Money,
     ): Result<PaymentIntentionResult> = runCatching {
         // Option B: Bypass local backend and create intention directly with Paymob API
-        val secretKey = "your_secret_key_here"
-        val publicKey = "your_public_key_here"
+        val secretKey = com.dukkan.payment.BuildConfig.PAYMOB_CLIENT_SECRET
+        val publicKey = com.dukkan.payment.BuildConfig.PAYMOB_PUBLIC_KEY
         
         val amountInCents = (cartTotal.amount * java.math.BigDecimal("100")).toInt()
         val json = org.json.JSONObject().apply {
