 .../payment/presentation/CheckoutEvent.kt      |  7 ++++++-
 .../payment/presentation/CheckoutScreen.kt     | 10 ++++++++--
 .../payment/presentation/CheckoutViewModel.kt  | 18 +++++++++++++++++-
 .../components/PaymobSdkLauncher.kt            | 12 ++++++++----
 5 files changed, 45 insertions(+), 8 deletions(-)

diff --git a/core/payment/src/main/java/com/dukkan/payment/PaymentResult.kt b/core/payment/src/main/java/com/dukkan/payment/PaymentResult.kt
index aa2774a..b7149e7 100644
